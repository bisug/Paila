# Copy to .env.local and fill in. The app runs in demo mode with zero env vars
# (in-memory Supabase stand-in, dev only).

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Maps are fully free and keyless: MapLibre GL + OpenFreeMap tiles, Nominatim
# geocoding, OSRM routing, Open-Meteo elevation. No map tokens needed.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Local-only demo scanner. Keep unset in production unless a real recognition provider is wired.
ENABLE_DEMO_SCAN=
